{
    "name": "clickandmortar/module-cube",
    "description": "Read-only REST API exposing today's sales stats (no personal data) for the Click&Mortar Cube Magento display.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "1.0.2",
    "authors": [
        {
            "name": "Click&Mortar",
            "homepage": "https://www.clickandmortar.fr"
        }
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "^103.0.6",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-integration": "^100.4",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.1"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "ClickAndMortar\\Cube\\": ""
        }
    },
    "archive": {
        "exclude": ["/.git", "/.gitignore", "/docker", "/build"]
    }
}
